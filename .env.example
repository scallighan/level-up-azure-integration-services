# Copy this file to .env and set the values once for your workshop session.
# Keep .env local. Do not store credentials, callback URLs, or access keys here.

AZURE_SUBSCRIPTION_ID=""
WORKSHOP_PREFIX=""
AZURE_LOCATION="westus"
# Optional existing parent group; empty means create a workshop group.
EXISTING_RESOURCE_GROUP_NAME=""

# Lab 0 Terraform inputs (leave these mappings unchanged).
TF_VAR_subscription_id="$AZURE_SUBSCRIPTION_ID"
TF_VAR_prefix="$WORKSHOP_PREFIX"
TF_VAR_location="$AZURE_LOCATION"
TF_VAR_existing_resource_group_name="$EXISTING_RESOURCE_GROUP_NAME"

# Later labs only; not required to deploy Lab 0.
# Copy resource_group_name from foundation.deployment.json after Lab 0.
FOUNDATION_RESOURCE_GROUP_NAME=""
STATIC_WEB_APP_LOCATION="westus2"
API_MANAGEMENT_MODE="none"
# Required only for the optional existing-APIM extension.
EXISTING_APIM_NAME=""
EXISTING_APIM_RESOURCE_GROUP_NAME=""

TF_VAR_foundation_resource_group_name="$FOUNDATION_RESOURCE_GROUP_NAME"
TF_VAR_static_web_app_location="$STATIC_WEB_APP_LOCATION"
TF_VAR_api_management_mode="$API_MANAGEMENT_MODE"
TF_VAR_existing_apim_name="$EXISTING_APIM_NAME"
TF_VAR_existing_apim_resource_group_name="$EXISTING_APIM_RESOURCE_GROUP_NAME"
