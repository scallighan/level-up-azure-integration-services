{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workshop.example/schemas/integration-design.schema.json",
  "title": "Workbook-derived Azure integration design",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "workbook",
    "evidence",
    "assumptions",
    "flows",
    "azureResources",
    "identityBoundaries",
    "reliability",
    "observability",
    "security",
    "implementationStages",
    "validation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "proposed",
        "approved"
      ]
    },
    "workbook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileName",
        "sheetsReviewed"
      ],
      "properties": {
        "fileName": {
          "type": "string",
          "minLength": 1
        },
        "sheetsReviewed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sheet",
          "cells",
          "finding"
        ],
        "properties": {
          "sheet": {
            "type": "string",
            "minLength": 1
          },
          "cells": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Z]+[1-9][0-9]*$"
            }
          },
          "finding": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "mustConfirmBeforeImplementation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^A-[0-9]{3}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "mustConfirmBeforeImplementation": {
            "type": "boolean"
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "trigger",
          "sourceFormat",
          "targetFormat",
          "steps",
          "failureBehavior"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "sourceFormat": {
            "type": "string",
            "minLength": 1
          },
          "targetFormat": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "failureBehavior": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "azureResources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "purpose",
          "required",
          "costBearing"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "costBearing": {
            "type": "boolean"
          }
        }
      }
    },
    "identityBoundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identity",
          "resource",
          "permissions",
          "scope"
        ],
        "properties": {
          "identity": {
            "type": "string",
            "minLength": 1
          },
          "resource": {
            "type": "string",
            "minLength": 1
          },
          "permissions": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reliability": {
      "$ref": "#/$defs/nonemptyStringArray"
    },
    "observability": {
      "$ref": "#/$defs/nonemptyStringArray"
    },
    "security": {
      "$ref": "#/$defs/nonemptyStringArray"
    },
    "implementationStages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "outcome"
        ],
        "properties": {
          "stage": {
            "type": "integer",
            "minimum": 0
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "validation": {
      "$ref": "#/$defs/nonemptyStringArray"
    }
  },
  "$defs": {
    "nonemptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
