{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workshop.example/schemas/order-created.schema.json",
  "title": "Order created event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "correlationId",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "order.created"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orderId",
        "customerId",
        "customerEmail",
        "total",
        "currency"
      ],
      "properties": {
        "orderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "customerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "customerEmail": {
          "type": "string",
          "format": "email"
        },
        "total": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    }
  }
}
